# Claude API 金鑰。沒有設定時，辨識功能會以「示範模式」回傳範例資料。
# 申請：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# 存取密碼。設定後，所有頁面與 API 都要先登入。
# 正式環境（npm start / 部署）沒設定時會拒絕所有請求，避免收藏庫對外公開；
# 本機 npm run dev 沒設定則不需要登入。
# CHIIKAWA_PASSWORD=換成一組夠長的密碼

# ---------------------------------------------------------------
# 儲存位置
# ---------------------------------------------------------------
# 不設定時會自動判斷：看到 BLOB_READ_WRITE_TOKEN 就用 Vercel Blob，
# 否則寫本機檔案。通常不需要手動指定。
# CHIIKAWA_STORAGE=json    # json | blob

# 本機檔案驅動的存放目錄，預設為專案下的 ./data
# CHIIKAWA_DATA_DIR=/path/to/data

# Vercel Blob 的金鑰。在 Vercel 建立 Blob store 後會自動注入，
# 本機通常不需要設定。
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ---------------------------------------------------------------
# 各參考市場兌新台幣的匯率，預設值如下
# ---------------------------------------------------------------
# TOMICA_JPY_TWD=0.21
# TOMICA_USD_TWD=32
# TOMICA_HKD_TWD=4.1
# TOMICA_EUR_TWD=35
# TOMICA_CNY_TWD=4.5

# Claude API 金鑰。沒有設定時，辨識功能會以「示範模式」回傳範例資料。
# 申請：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------
# Google 登入（任何 Google 帳號都能登入，每人各自一份收藏庫）
# ---------------------------------------------------------------
# 三個都設定才會啟用。正式環境（npm start / 部署）沒設定時會拒絕所有請求，
# 避免收藏庫對外公開；本機 npm run dev 三個都不設則不需要登入（當作「本機使用者」）。
# 建立方式見 README 的「設定 Google 登入」。
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# 簽章 session 用的密鑰，至少 32 個字元。產生：openssl rand -base64 32
# AUTH_SECRET=

# AI 鑑定每人每天的次數上限，預設 10，台灣時間午夜重置。設 0 代表只有管理員能用。
# CHIIKAWA_AI_DAILY_LIMIT=10
# 不受次數限制的帳號，以逗號分隔
# CHIIKAWA_ADMIN_EMAILS=you@gmail.com

# ---------------------------------------------------------------
# 儲存位置
# ---------------------------------------------------------------
# 不設定時會自動判斷：看到 BLOB_READ_WRITE_TOKEN 就用 Vercel Blob，
# 否則寫本機檔案。通常不需要手動指定。
# CHIIKAWA_STORAGE=json    # json | blob

# 本機檔案驅動的存放目錄，預設為專案下的 ./data
# CHIIKAWA_DATA_DIR=/path/to/data

# Vercel Blob 的金鑰。在 Vercel 建立 Blob store 後會自動注入，
# 本機通常不需要設定。
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ---------------------------------------------------------------
# 各參考市場兌新台幣的匯率，預設值如下
# ---------------------------------------------------------------
# TOMICA_JPY_TWD=0.21
# TOMICA_USD_TWD=32
# TOMICA_HKD_TWD=4.1
# TOMICA_EUR_TWD=35
# TOMICA_CNY_TWD=4.5
